// Production — www.ituob.org
//
// Static assets only today; the same Worker gains an API surface later
// (add `main` + D1/Access bindings — see docs/cloudflare-webapp.adoc).
//
// The ituob.org zone is on Cloudflare (pending nameserver activation);
// the custom domain provisions its DNS record + certificate on deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ituob-org",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "www.ituob.org", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
