{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ituob-org",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "www.ituob.org",
      "custom_domain": true
    },
    {
      "pattern": "ituob.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
