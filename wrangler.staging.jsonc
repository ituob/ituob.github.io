// Staging — the pre-production soak channel.
//
// Deploys from the `staging` branch; serves <name>.<account>.workers.dev
// until the staging-www.ituob.org custom domain is provisioned (needs the
// ituob.org zone on Cloudflare):
//   "workers_dev": false,
//   "routes": [{ "pattern": "staging-www.ituob.org", "custom_domain": true }]
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ituob-org-staging",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
