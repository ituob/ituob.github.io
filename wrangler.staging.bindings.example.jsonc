// OPT-IN EXAMPLE ONLY: provision resources and replace placeholder IDs before use.
// Not selected by CI. See docs/cloudflare-bindings.adoc.
// Staging — the pre-production soak channel.
//
// Deploys from the `staging` branch; serves staging-www.ituob.org
// (custom domain auto-provisioned into the Cloudflare zone on deploy).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ituob-org-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "staging-www.ituob.org", "custom_domain": true }],
  "run_worker_first": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Bindings: docs/cloudflare-bindings.adoc. The database_id is a PLACEHOLDER
  // until the owner runs `wrangler d1 create ituob-org-staging-db` and pastes the real id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ituob-org-staging-db",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "binding": "NOTIFY_Q", "queue": "ituob-notify-staging" }],
    "consumers": [{ "queue": "ituob-notify-staging", "max_batch_size": 10, "max_retries": 5 }]
  },
  // scheduled(): outbox sweep (re-enqueues rows stale > 5 min) + reconcile.
  "triggers": { "crons": ["*/5 * * * *"] }
}
