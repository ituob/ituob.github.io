---
/**
 * Search box — triggers Pagefind modal search.
 * Pagefind is initialized post-build by `astro-pagefind` integration.
 * The search UI is a simple input that calls the Pagefind browser API.
 */
---

<div class="search-container no-print" id="search-container">
  <button
    type="button"
    id="search-trigger"
    class="flex items-center gap-2 px-3 py-1.5 rounded border border-[var(--rule)] text-[var(--step--1)] hover:border-[var(--accent)] transition-colors"
    style="font-family: var(--font-sans); color: var(--fg-muted);"
    aria-label="Search"
  >
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="6" cy="6" r="4.5" />
      <path d="M9.5 9.5l3 3" stroke-linecap="round" />
    </svg>
    <span>Search</span>
  </button>
</div>

<script>
  const trigger = document.getElementById("search-trigger");
  if (trigger) {
    trigger.addEventListener("click", async () => {
      // Pagefind lazy-loads on first interaction.
      if (!window.__pagefind__) {
        try {
          window.__pagefind__ = await import("/pagefind/pagefind-entry.js");
          await window.__pagefind__.options({});
          await window.__pagefind__.init();
        } catch (e) {
          console.warn("Pagefind not available — run npm run build with pagefind first.");
          return;
        }
      }
      const search = await window.__pagefind__.search("");
      if (search.results.length > 0) {
        window.location.href = "/search/";
      }
    });
  }
</script>
