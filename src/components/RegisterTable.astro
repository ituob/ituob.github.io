---
/**
 * Register snapshot table — renders the replayed register state
 * (active entries, with optional lapsed/deleted rows greyed out).
 */
import type { RegisterState } from "~/lib/snapshots";
import { formatCellValue } from "~/lib/values";
import { fieldLabel, hasValue, orderFields } from "~/lib/columns";

export interface Props {
  state: RegisterState;
  keyField: string | string[];
  showLapsed?: boolean;
  slug?: string;
}
const { state, showLapsed = false, slug, keyField } = Astro.props;

// The replay key of an entry: the key field, or the composite key
// fields joined the way the replay joins them. With a slug, the key
// cell links to the citable entry page.
const keyOf = (entry: Record<string, unknown>): string => {
  if (Array.isArray(keyField)) {
    return keyField.map((f) => (entry[f] == null ? "" : String(entry[f]))).join(" | ");
  }
  const v = entry[keyField];
  return v == null ? "" : String(v);
};
const keyCols = Array.isArray(keyField) ? keyField : [keyField];

// Compute columns as the union of ALL field keys across every
// active entry, so entries with different field sets all show. A
// column that is empty for every entry is dropped, and the remaining
// columns follow the printed order — country first.
const colSet = new Set<string>();
for (const entry of state.active_entries) {
  for (const key of Object.keys(entry)) {
    if (key !== "_class" && key !== "source_contents" && hasValue(entry[key])) colSet.add(key);
  }
}
for (const key of keyCols) colSet.add(key);
const cols = orderFields([...colSet], keyCols);


---
{state.active_entries.length > 0 ? (
  <div class="overflow-x-auto">
    <table class="table-bulletin">
      <thead>
        <tr>
          {cols.map((c) => (
            <th>{fieldLabel(c)}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {state.active_entries.map((entry) => (
          <tr>
            {cols.map((c) => (
              <td>
                {slug && keyCols.includes(c) && entry[c] != null ? (
                  <a
                    href={`/registers/${slug}/entries/${encodeURIComponent(keyOf(entry))}/`}
                    class="no-underline hover:underline"
                  >
                    {formatCellValue(entry[c])}
                  </a>
                ) : (
                  formatCellValue(entry[c])
                )}
              </td>
            ))}
          </tr>
        ))}
        {showLapsed && state.lapsed_keys.map((key) => {
          // LIR'd entries are in history; we don't materialise them
          // in active_entries, so we just show a placeholder row.
          return (
            <tr class="opacity-50">
              <td colspan={cols.length}>
                <em>{key} — lapsed</em>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
) : (
  <p class="italic text-[var(--step--1)]" style="color: var(--fg-muted);">
    Register is empty at this point in time.
  </p>
)}

<p class="text-[var(--step--1)] mt-3" style="color: var(--fg-subtle); font-family: var(--font-sans);">
  {state.entry_count} active entries
  {state.lapsed_count > 0 && <>, {state.lapsed_count} lapsed</>}
  {state.deleted_count > 0 && <>, {state.deleted_count} deleted</>}
  {state.at_ob_issue && <>; as of issue № {state.at_ob_issue}</>}.
</p>
