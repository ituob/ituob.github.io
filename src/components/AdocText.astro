---
/**
 * AsciiDoc asset rendering for general messages whose content was
 * normalized as a file reference (e.g. "general/misc_comms.adoc").
 * Conversion lives in ~/lib/adoc.
 */
import { adocToHtml } from "~/lib/adoc";

interface Props {
  text: string;
}
const { text } = Astro.props;
---
<div class="prose-bulletin" set:html={adocToHtml(text)} />
