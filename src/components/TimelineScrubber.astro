---
/**
 * Timeline scrubber for register snapshots.
 *
 * Shows every OB issue that touched the register, with the current
 * view highlighted. Hyperlinks to /datasets/{slug}/at/{ob_issue}/.
 */
export interface Props {
  slug: string;
  touchedIssues: number[];
  currentIssue: number | null;
  seedIssue: number | null;
}
const { slug, touchedIssues, currentIssue, seedIssue } = Astro.props;
const sorted = [...touchedIssues].sort((a, b) => a - b);
---
{sorted.length > 0 && (
  <nav class="timeline-scrubber no-print panel p-4 mb-6" aria-label="Register timeline">
    <p class="text-[var(--step--1)] uppercase tracking-wider mb-2" style="font-family: var(--font-sans); color: var(--fg-muted);">
      Timeline — point in time
    </p>
    <ol class="flex flex-wrap gap-1.5" style="font-family: var(--font-sans);">
      {sorted.map((n) => {
        const isCurrent = n === currentIssue;
        const isSeed = n === seedIssue;
        return (
          <li>
            <a
              href={`/datasets/${slug}/at/${n}/`}
              class:list={["chip no-underline", { "chip-active": isCurrent }]}
              title={isSeed ? "Initial publication (seed)" : `OB No. ${n}`}
              aria-current={isCurrent ? "location" : undefined}
            >
              {isSeed ? "★ " : ""}{n}
            </a>
          </li>
        );
      })}
    </ol>
  </nav>
)}
