---
/**
 * Render authored prose or legacy ProseMirror content, with a
 * localized fallback chain.
 *
 * Includes the optional "In accordance with ITU-T X.YYY (version)"
 * recommendation reference and an "Online" link when the message type
 * has either configured.
 */
import ProseMirror from "~/components/ProseMirror.astro";
import type { TextualGeneralMessage } from "~/lib/types";
import { resolveGeneralContent } from "~/lib/i18n";
import GeneralMessageMetadata from "./GeneralMessageMetadata.astro";
import type { Language } from "~/lib/catalogs";

export interface Props {
  message: TextualGeneralMessage;
  lang?: Language;
  showMetadata?: boolean;
}
const { message, lang = "en", showMetadata = true } = Astro.props;
const doc = resolveGeneralContent(message.contents, lang);
const nodes = typeof doc === "object" ? doc?.content ?? [] : [];
const textField = (message as unknown as { text?: unknown }).text;
const plainText = typeof doc === "string" ? doc : typeof textField === "string" ? textField : null;
---
{showMetadata && <GeneralMessageMetadata message={message} />}
{nodes.length > 0 ? (
  <div class="prose-bulletin">
    {nodes.map((node) => <ProseMirror node={node} />)}
  </div>
) : plainText !== null ? (
  <div class="prose-bulletin" style="white-space: pre-wrap;">{plainText}</div>
) : (
  <p style="color: var(--fg-subtle); font-style: italic;">No content available.</p>
)}

