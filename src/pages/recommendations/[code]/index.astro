---
import Base from "~/layouts/Base.astro";
import {
  buildRecommendationIndex,
  loadIssue,
  loadRegisterCatalog,
  loadListMetadata,
  registersAmendedInIssue,
  generalMessagesForRec,
} from "~/lib/loaders";
import { loadStateAtIssue, groupHistoryByIssue, type ChangeHistoryEntry } from "~/lib/snapshots";
import { obIssuesRoot, readYamlOrNull, join } from "~/lib/fs";
import { formatSwissDate, slugifyRecCode, deslugifyRecCode } from "~/lib/format";
import type { GeneralMessageType, Language } from "~/lib/catalogs";
import RecommendationTimeline from "~/components/RecommendationTimeline.astro";

export function getStaticPaths() {
  const idx = buildRecommendationIndex();
  return [...idx.keys()].map((code) => ({
    params: { code: slugifyRecCode(code) },
  }));
}

const { code: rawCode } = Astro.params;
const code = deslugifyRecCode(rawCode!);
const idx = buildRecommendationIndex();
const rec = idx.get(code);
if (!rec) return Astro.redirect("/recommendations/");

const title = rec.title?.en;
const lang: Language = "en";

// Build a slug → register-title lookup so the per-issue amendment
// blocks can show the affected register's name.
const registers = loadRegisterCatalog();
const registerTitleBySlug = new Map<string, string>();
for (const r of registers) {
  if (r.title?.en) registerTitleBySlug.set(r.slug, r.title.en);
}

// Group issues by year (descending). Each issue block lists every
// register under this rec that was amended in that issue, plus any
// general messages (telephone_service_2, ipns, sanc, ...) tied to
// the rec.
interface IssueBlock {
  id: number;
  date: string | null;
  positionOn: string | null;
  positionOnIssue: number | null;
  registers: {
    slug: string;
    title: string;
    changes: ChangeHistoryEntry[];
  }[];
  generalMessages: { type: GeneralMessageType; message: any }[];
  hasApprovals: boolean;
}

// Per-issue position_on date — mirrors the deployed "Position
// amended originally published as annex to OB X — D.MMM.YYYY" line.
function positionOnForIssue(issueId: number, pubIds: string[]): { date: string | null; issue: number | null } {
  for (let i = issueId; i >= 0; i--) {
    const ax = readYamlOrNull<Record<string, any>>(join(obIssuesRoot(), String(i), "annexes.yaml"));
    if (!ax) continue;
    for (const pub of pubIds) {
      if (ax[pub] && ax[pub].position_on) {
        return { date: ax[pub].position_on, issue: i };
      }
    }
  }
  return { date: null, issue: null };
}
const recPubIds = registers.filter((r) => r.recommendation === code).map((r) => r.register_id);

const yearGroups = new Map<number, IssueBlock[]>();
for (const id of rec.issueIds) {
  const issue = loadIssue(id);
  const isoDate = issue?.meta?.publication_date ?? null;
  const year = isoDate ? Number.parseInt(isoDate.slice(0, 4), 10) : null;
  if (year === null) continue;

  const amendedSlugs = registersAmendedInIssue(code, id);
  const amendedRegisters = amendedSlugs.map((slug) => {
    const state = loadStateAtIssue(slug, id);
    const changes = state ? (groupHistoryByIssue(state).get(id) ?? []) : [];
    return {
      slug,
      title: registerTitleBySlug.get(slug) ?? slug,
      changes,
    };
  });

  const generalMessages = generalMessagesForRec(code, id).map((m) => ({
    type: m.type,
    message: m,
  }));

  const hasApprovals = !!issue?.general.approvedRecommendations?.payload?.items?.[code];

  // Skip issues that contribute nothing for this rec.
  if (amendedRegisters.length === 0 && generalMessages.length === 0 && !hasApprovals) {
    continue;
  }

  const positionOn = positionOnForIssue(id, recPubIds);

  const block: IssueBlock = {
    id,
    date: isoDate,
    positionOn: positionOn.date,
    positionOnIssue: positionOn.issue,
    registers: amendedRegisters,
    generalMessages,
    hasApprovals,
  };
  const arr = yearGroups.get(year) ?? [];
  arr.push(block);
  yearGroups.set(year, arr);
}

const years = [...yearGroups.keys()].sort((a, b) => b - a);
const issueCount = rec.issueIds.length;
---
<Base title={`ITU-T ${code}`} wide description={`ITU-T Recommendation ${code} — referenced by the ITU Operational Bulletin.`}>
  <header class="mb-8">
    <p class="uppercase font-semibold" style="font-family: var(--font-sans); font-size: var(--step--1); letter-spacing: 0.1em; color: var(--accent);">
      Messages complement to ITU-T Recommendation
    </p>
    <h1 class="sr-only">ITU-T Recommendation {code}</h1>
    <h2 class="mt-1 num" style="font-family: var(--font-display); font-size: var(--step-4); font-weight: 700;">
      {code}
    </h2>
    {title && (
      <p class="mt-2" style="font-family: var(--font-display); font-size: var(--step-1); color: var(--fg);">
        {title}
      </p>
    )}
    {rec.version && (
      <p class="mt-1 text-[var(--step--1)]" style="font-family: var(--font-sans); color: var(--fg-muted);">
        Last approved: {formatSwissDate(rec.version)}
      </p>
    )}
    <p class="mt-3 text-[var(--step--1)]" style="font-family: var(--font-sans); color: var(--fg-muted);">
      Referenced in {issueCount} issue{issueCount !== 1 ? "s" : ""} of the Bulletin.
    </p>
    {(() => {
      // Fall back to list metadata URL when rec.url is absent.
      // Use registers for THIS recommendation, not the entire catalog.
      const recRegisters = registers.filter((r) => r.recommendation === code);
      const listUrl = recRegisters.length > 0
        ? (recRegisters[0] as any)?.url ?? loadListMetadata(recRegisters[0]?.register_id ?? "")?.url
        : null;
      const url = rec.url ?? listUrl;
      return url ? (
        <p class="mt-2 text-[var(--step--1)]" style="font-family: var(--font-sans);">
          <a href={url} class="tint" rel="noopener noreferrer">Authoritative resource ↗</a>
        </p>
      ) : null;
    })()}
  </header>

  {years.length > 0 ? (
    <>
      <nav class="rule-thin pt-3 mb-6" aria-label="Year navigation">
        <p class="text-[var(--step--1)]" style="font-family: var(--font-sans); color: var(--fg-muted);">
          Showing data for <span class="num">{years[0]!}</span>.
          {years.length > 1 && (
            <>
              {" "}Browse previous years:{" "}
              {years.slice(1).map((y, i) => (
                <>
                  {i > 0 && " "}
                  <a href={`#year-${y}`} class="num hover:underline">{y}</a>
                </>
              ))}
            </>
          )}
        </p>
        <ul class="flex flex-wrap gap-2 mt-2" style="font-family: var(--font-sans);">
          {years.map((y) => (
            <li>
              <a
                href={`#year-${y}`}
                class="inline-block panel px-3 py-1 no-underline hover:border-[var(--accent)] transition-colors text-[var(--step--1)]"
              >
                <span class="num font-semibold">{y}</span>
                <span class="ml-1" style="color: var(--fg-muted);">{yearGroups.get(y)!.length}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <RecommendationTimeline years={years} yearGroups={yearGroups} lang={lang} />
    </>
  ) : (
    <section>
      <header class="rule-thin pt-3 mb-4">
        <h2 class="text-[var(--step-2)]" style="font-family: var(--font-display);">About this Recommendation</h2>
      </header>
      <p style="font-family: var(--font-sans); color: var(--fg-muted);">
        This Recommendation mandates one or more Service Publication
        registers annexed to the Operational Bulletin. See the linked
        register(s) for current entries and amendment history.
      </p>
    </section>
  )}
</Base>
