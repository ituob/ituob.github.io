---
import LegacyMessageArchive from "~/components/LegacyMessageArchive.astro";
import { legacyArchiveScopes } from "~/lib/legacy-archive-scopes";

export function getStaticPaths() {
  return legacyArchiveScopes.filter((scope) => scope.kind === "register" && scope.year === undefined).map((scope) => ({
    params: { slug: scope.slug, edition: scope.editionToken }, props: { scope },
  }));
}

const { scope } = Astro.props;
---
<LegacyMessageArchive scope={scope} />
