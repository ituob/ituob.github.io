---
import Base from "~/layouts/Base.astro";
import { listSnapshotSlugs, loadManifest, loadCurrentState } from "~/lib/snapshots";
import { itemPath, listRegisterItems } from "~/lib/item-history";

export function getStaticPaths() {
  return listSnapshotSlugs().map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params;
const manifest = loadManifest(slug!);
const state = loadCurrentState(slug!);
if (!manifest || !state) return Astro.redirect("/404/");
const title = manifest.title.en ?? manifest.slug;
const items = listRegisterItems(state, manifest.key_field);
---
<Base title={`${title} — Items`} masthead description={`Current and withdrawn items in ${title}.`}>
  <section class="rule-thin pt-6 pb-6">
    <p><a href={`/registers/${slug}/`}>← Back to register</a></p>
    <h2 class="text-[var(--step-3)] mt-4">{title} — Items</h2>
    <p class="mt-2">Browse current, lapsed and deleted items and their individual change histories.</p>
  </section>
  <ul class="space-y-2">
    {items.map((item) => (
      <li><a href={itemPath(slug!, item.key)}><code>{item.key}</code></a> · {item.status}</li>
    ))}
  </ul>
  {items.length === 0 && <p>No items are available in this snapshot.</p>}
</Base>
