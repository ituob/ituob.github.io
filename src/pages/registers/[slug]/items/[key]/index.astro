---
import Base from "~/layouts/Base.astro";
import { listSnapshotSlugs, loadManifest, loadCurrentState } from "~/lib/snapshots";
import type { RegisterItem } from "~/lib/item-history";
import { itemHistory, itemRouteToken, listRegisterItems } from "~/lib/item-history";
import { formatCellValue } from "~/lib/values";

export function getStaticPaths() {
  return listSnapshotSlugs().flatMap((slug) => {
    const manifest = loadManifest(slug);
    const state = loadCurrentState(slug);
    if (!manifest || !state) return [];
    return listRegisterItems(state, manifest.key_field).map((item) => ({
      params: { slug, key: itemRouteToken(item.key) }, props: { item },
    }));
  });
}
interface Props { item: RegisterItem }
const { item } = Astro.props;
const { slug } = Astro.params;
const manifest = loadManifest(slug!);
const state = loadCurrentState(slug!);
if (!manifest || !state) return Astro.redirect("/404/");
const title = manifest.title.en ?? manifest.slug;
const history = itemHistory(state, item.key);
---
<Base title={`${item.key} — ${title}`} masthead description={`Change history for item ${item.key} in ${title}.`}>
  <section class="rule-thin pt-6 pb-6">
    <p><a href={`/registers/${slug}/items/`}>← All register items</a> · <a href={`/registers/${slug}/`}>{title}</a></p>
    <h2 class="text-[var(--step-3)] mt-4">Item <code>{item.key}</code></h2>
    <p class="mt-2">Status: {item.status}</p>
  </section>
  {item.entry && (
    <section class="mb-6">
      <h3 class="text-[var(--step-2)]">Current entry</h3>
      <dl>
        {Object.entries(item.entry).filter(([field]) => field !== "_class" && field !== "source_contents").map(([field, value]) => (
          <div class="mt-2"><dt class="font-semibold">{field.replace(/_/g, " ")}</dt><dd>{formatCellValue(value)}</dd></div>
        ))}
      </dl>
    </section>
  )}
  <section>
    <h3 class="text-[var(--step-2)]">Item change history</h3>
    {history === null ? (
      <p class="mt-2">Item history is unavailable in this snapshot. <a href={`/registers/${slug}/history/`}>View the register change history.</a></p>
    ) : history.length === 0 ? (
      <p class="mt-2">No changes recorded for this item.</p>
    ) : (
      <ol class="space-y-3 mt-4">
        {history.map((event) => (
          <li class="panel p-4">
            <strong>{event.type === "SEED" ? "SEED — Initial publication" : event.type}</strong>
            {event.ob_issue !== null && <> · <a href={`/issues/${event.ob_issue}/`}>OB No. {event.ob_issue}</a></>}
            {Object.keys(event.identifier).length > 0 && <p class="mt-2">Published identifier: <code>{JSON.stringify(event.identifier)}</code></p>}
          </li>
        ))}
      </ol>
    )}
  </section>
</Base>
