---
/**
 * Register page — a thin selector between the two register kinds:
 * keyed registers (snapshots, entries, editions) and textual
 * publications (documents amended through issues).
 */
import Base from "~/layouts/Base.astro";
import RegisterInternal from "~/components/registers/RegisterInternal.astro";
import RegisterExternal from "~/components/registers/RegisterExternal.astro";
import { listSnapshotSlugs, loadManifest, loadCurrentState } from "~/lib/snapshots";
import { loadRegisterCatalog, loadListMetadata } from "~/lib/loaders";

export function getStaticPaths() {
  const snapshotSlugs = listSnapshotSlugs();
  const catalog = loadRegisterCatalog();
  const externalSlugs = catalog
    .filter((r) => r.external)
    .map((r) => r.slug)
    .filter((slug) => !snapshotSlugs.includes(slug));
  return [...snapshotSlugs, ...externalSlugs].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const manifest = loadManifest(slug!);
const state = loadCurrentState(slug!);
const catalogEntry = loadRegisterCatalog().find((r) => r.slug === slug);
const isExternal = !manifest || !state;

const recommendation = isExternal
  ? (catalogEntry?.recommendation ?? "")
  : (manifest.recommendation ?? manifest.register_id.replace(/_.*$/, ""));
const recommendationVersion = (() => {
  const pubId = catalogEntry?.register_id ?? manifest?.register_id ?? slug;
  return loadListMetadata(pubId)?.recommendation?.version ?? "";
})();
const title = isExternal
  ? (catalogEntry?.title?.en ?? catalogEntry?.register_id ?? slug)
  : (manifest.title.en ?? manifest.slug);
const errorSummary = (() => {
  if (!state || state.error_count === 0) return null;
  const errs = (state.errors as string[]) ?? [];
  const lir = errs.filter((e) => e.startsWith("skip LIR")).length;
  const dup = errs.filter((e) => e.includes("already exists")).length;
  const other = state.error_count - lir - dup;
  const n = (count: number, singular: string, plural: string) => `${count} ${count === 1 ? singular : plural}`;
  const parts: string[] = [];
  if (lir > 0) parts.push(n(lir, "unmatched repetition", "unmatched repetitions"));
  if (dup > 0) parts.push(n(dup, "skipped duplicate entry", "skipped duplicate entries"));
  if (other > 0) parts.push(n(other, "unapplied change", "unapplied changes"));
  return parts.join(" + ");
})();
---
<Base title={`Register: ${title}`}
      description={isExternal ? `${title} — external register.` : `${title} register — the current edition. ${state.entry_count} active entries.`}
      masthead wide
      breadcrumbs={[{ label: "Registers", href: "/registers/" }, { label: title }]}>
  {isExternal ? (
    <RegisterExternal
      slug={slug!}
      title={title}
      recommendation={recommendation}
      recommendationVersion={recommendationVersion}
      registerId={catalogEntry?.register_id ?? slug!}
    />
  ) : (
    <RegisterInternal
      slug={slug!}
      manifest={manifest}
      state={state}
      recommendation={recommendation}
      recommendationVersion={recommendationVersion}
      errorSummary={errorSummary}
    />
  )}
</Base>
