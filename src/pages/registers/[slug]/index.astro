---
/**
 * Register detail page — shows the replayed register current state
 * with timeline scrubber and change-history link.
 *
 * Registers without snapshots (external publications like NNP, List V,
 * List VIII) show a list of OB issues that contain amendments
 * referencing this register, plus a link to the authoritative source.
 */
import Base from "~/layouts/Base.astro";
import {
  listSnapshotSlugs,
  loadManifest,
  loadCurrentState,
} from "~/lib/snapshots";
import { loadRegisterCatalog, listIssueIds, loadIssue, loadListMetadata, lastAnnexBefore } from "~/lib/loaders";
import { obIssuesRoot, readYamlOrNull, join } from "~/lib/fs";
import { formatSwissDate } from "~/lib/format";
import TimelineScrubber from "~/components/TimelineScrubber.astro";
import RegisterYearArchive from "~/components/RegisterYearArchive.astro";
import RegisterHistory from "~/components/RegisterHistory.astro";
import IssueArchive from "~/components/IssueArchive.astro";
import RegisterTable from "~/components/RegisterTable.astro";
import TextualAmendment from "~/components/TextualAmendment.astro";
import StructuredAmendment from "~/components/StructuredAmendment.astro";
import type { TextAmendment, PlaceholderAmendment, SequencedAmendment } from "~/lib/types";

export function getStaticPaths() {
  const snapshotSlugs = listSnapshotSlugs();
  const catalog = loadRegisterCatalog();
  const externalSlugs = catalog
    .filter((r) => r.external)
    .map((r) => r.slug)
    .filter((slug) => !snapshotSlugs.includes(slug));
  return [...snapshotSlugs, ...externalSlugs].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const manifest = loadManifest(slug!);
const state = loadCurrentState(slug!);
const catalogEntry = loadRegisterCatalog().find((r) => r.slug === slug);

const isExternal = !manifest || !state;
const title = isExternal
  ? (catalogEntry?.title?.en ?? catalogEntry?.register_id ?? slug)
  : (manifest.title.en ?? manifest.slug);
const recommendation = isExternal
  ? (catalogEntry?.recommendation ?? "")
  : (manifest.recommendation ?? manifest.register_id.replace(/_.*$/, ""));
// Printed recommendation version ("F.32 (1995-10)") from the per-list
// metadata, mirroring the deployed "In accordance with" line.
const recommendationVersion = (() => {
  const pubId = catalogEntry?.register_id ?? manifest?.register_id ?? slug;
  return loadListMetadata(pubId)?.recommendation?.version ?? "";
})();
const description = isExternal
  ? `${title} — external register.`
  : `${title} register — current state. ${state.entry_count} active entries.`;

// For external/textual registers, find issues that contain amendments
// referencing this register's publication ID.
interface AmendingIssue {
  id: number;
  date: string | null;
  preview: string;
  textualAmendment: TextAmendment | null;
  placeholderAmendment: PlaceholderAmendment | null;
  structuredAmendments: SequencedAmendment[];
}
const amendingIssues: AmendingIssue[] = [];
if (isExternal) {
  const pubIdBySlug = new Map<string, string>();
  for (const r of loadRegisterCatalog()) {
    pubIdBySlug.set(r.slug, r.register_id);
  }

  for (const id of listIssueIds()) {
    const issue = loadIssue(id);
    const issueDate = issue?.meta?.publication_date ?? null;
    if (!issue) continue;

    // Prefer the issue loader's parsed amendment; fall back to direct
    // text.yaml read for registers where the loader's slug mapping
    // misses.
    const textual = issue.amendments.textual[slug!] ?? null;
    const placeholder = issue.amendments.placeholder[slug!] ?? null;
    const structured = issue.amendments.structured[slug!] ?? [];

    let textAmendment = textual;
    if (!textAmendment) {
      const textPath = join(obIssuesRoot(), String(id), slug!, "text.yaml");
      const textData = readYamlOrNull<TextAmendment>(textPath);
      if (textData && textData.contents) textAmendment = textData;
    }

    if (textAmendment || placeholder || structured.length > 0) {
      let preview = "";
      if (textAmendment?.contents) {
        const doc = (textAmendment.contents as any).en ?? textAmendment.contents;
        const parts: string[] = [];
        const walk = (node: any) => {
          if (!node) return;
          if (node.type === "text" && typeof node.text === "string") {
            parts.push(node.text);
          }
          if (Array.isArray(node.content)) {
            node.content.forEach((c: any) => walk(c));
          }
        };
        walk(doc);
        preview = parts.join(" ").trim().slice(0, 300);
      }
      amendingIssues.push({
        id,
        date: issueDate,
        preview,
        textualAmendment: textAmendment,
        placeholderAmendment: placeholder,
        structuredAmendments: structured,
      });
    }
  }
}
---
<Base title={`Register: ${title}`} masthead wide description={description}>
  <section class="rule-thin pt-6 pb-6">
    <p class="uppercase font-semibold text-[var(--step--1)]"
       style="font-family: var(--font-sans); letter-spacing: 0.1em; color: var(--accent);">
      Register
      {recommendation && ` · Recommendation ITU-T ${recommendation}`}
    </p>
    <p class="text-[var(--step--1)] mt-1" style="font-family: var(--font-sans); color: var(--fg-muted);">
      In accordance with ITU-T Recommendation {recommendation}
      {recommendationVersion && ` (${recommendationVersion})`}
    </p>
    <h2 class="text-[var(--step-4)] mt-1"
        style="font-family: var(--font-display); font-weight: 700; line-height: 1.1;">
      {title}
    </h2>
    {!isExternal && manifest?.seed_issue && (
      <p class="text-[var(--step--1)] mt-1" style="font-family: var(--font-sans); color: var(--fg-muted);">
        Annexed to{" "}
        <a href={`/issues/${manifest.seed_issue}/`} class="no-underline hover:underline">
          ITU OB No. {manifest.seed_issue}
        </a>
        {(() => {
          // Most-recent position_on date up to the latest issue.
          // Mirrors the deployed "Position on X" line.
          const ids = listIssueIds();
          const latest = ids.length > 0 ? ids[ids.length - 1]! : 0;
          const pubId = (catalogEntry as any)?.register_id ?? slug;
          const ref = lastAnnexBefore(latest, pubId);
          return ref?.positionOn ? (
            <>
              {" "}· Position on {formatSwissDate(ref.positionOn)}
            </>
          ) : null;
        })()}
      </p>
    )}
    {!isExternal && (
      <p class="mt-2 text-[var(--step--1)]" style="color: var(--fg-muted); font-family: var(--font-sans);">
        {state.entry_count} active entries
        {state.lapsed_count > 0 && ` · ${state.lapsed_count} lapsed`}
        {state.deleted_count > 0 && ` · ${state.deleted_count} deleted`}
        {state.error_count > 0 && ` · ${state.error_count} replay errors`}
        · current state (latest OB)
        {state.history.filter(p => p.type !== "SEED").length > 0 && (
          <> · Amended {state.history.filter(p => p.type !== "SEED").length} time{state.history.filter(p => p.type !== "SEED").length !== 1 ? "s" : ""} in subsequent editions</>
        )}
      </p>
    )}
    {isExternal && (
      (() => {
        const pubId = (catalogEntry as any)?.register_id ?? slug;
        const ids = listIssueIds();
        const latest = ids.length > 0 ? ids[ids.length - 1]! : 0;
        const ref = lastAnnexBefore(latest, pubId);
        const annexIssue: number | null = ref?.issueId ?? null;
        const lastPos: string | null = ref?.positionOn ?? null;
        return (annexIssue || amendingIssues.length > 0) ? (
          <p class="mt-2 text-[var(--step--1)]" style="color: var(--fg-muted); font-family: var(--font-sans);">
            {annexIssue && (
              <>
                Annexed to <a href={`/issues/${annexIssue}/`} class="no-underline hover:underline">ITU OB No. {annexIssue}</a>
              </>
            )}
            {lastPos && ` · Position on ${formatSwissDate(lastPos)}`}
            {amendingIssues.length > 0 && (
              <>
                {" "}· Amended {amendingIssues.length} time{amendingIssues.length !== 1 ? "s" : ""} in subsequent editions
                {" "}· Referenced in {amendingIssues.length} issue{amendingIssues.length !== 1 ? "s" : ""} of the Bulletin.
              </>
            )}
          </p>
        ) : null;
      })()
    )}
    {/* Authoritative resource link from the per-list meta.yaml. */}
    {(() => {
      const pubId = (catalogEntry as any)?.register_id ?? slug;
      const listMeta = loadListMetadata(pubId);
      const url = (catalogEntry as any)?.url ?? (listMeta as any)?.url;
      return url ? (
        <p class="mt-2 text-[var(--step--1)]" style="font-family: var(--font-sans);">
          <a href={url} class="tint" rel="noopener noreferrer">Authoritative resource ↗</a>
        </p>
      ) : null;
    })()}
  </section>

  {/* Year-archive navigation — mirrors the deployed Jekyll layout:
      "Showing data for X. Browse previous years: 2022 2021 ..." */}
<RegisterYearArchive
    slug={slug!}
    isExternal={isExternal}
    touchedIssues={manifest?.touched_issues ?? []}
    amendingIssueIds={amendingIssues.map((a) => a.id)}
  />

  {isExternal ? (
    <>
      {amendingIssues.length > 0 ? (
        <section>
          <header class="section-header" style="margin-bottom: 1.5rem;">
            <h3 style="font-size: var(--step-3); font-weight: 800; margin: 0;">
              Issues amending this register
            </h3>
          </header>
          <div class="sr-only">Date / Amendment</div>
          <ul class="space-y-3" style="font-family: var(--font-sans); list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem;">
            {amendingIssues.sort((a, b) => b.id - a.id).map((item) => (
              <li class="panel surface-hover" style="padding: 1rem 1.25rem;">
                <h3 class="text-[var(--step-0)] flex items-baseline gap-3 flex-wrap m-0">
                  <span style="font-family: var(--font-display); font-weight: 600;">
                    Amd.
                  </span>
                  <a href={`/issues/${item.id}/`} class="no-underline hover:underline">
                    OB no. <span class="num">{item.id}</span>
                  </a>
                </h3>
                {item.date && (
                  <p class="mt-1 text-[var(--step--1)]" style="color: var(--fg-muted);">
                    {formatSwissDate(item.date)}
                  </p>
                )}
                {/* Render full amendment content from the issue payload,
                    matching the deployed Jekyll layout. */}
                {item.textualAmendment && (
                  <div class="mt-3 prose-bulletin measure">
                    <TextualAmendment amendment={item.textualAmendment} />
                  </div>
                )}
                {item.placeholderAmendment && (
                  <div class="mt-3">
                    <TextualAmendment placeholder={item.placeholderAmendment} />
                  </div>
                )}
                {item.structuredAmendments.length > 0 && (
                  <div class="mt-3">
                    <StructuredAmendment amendments={item.structuredAmendments} />
                  </div>
                )}
              </li>
            ))}
          </ul>
        </section>
      ) : (
        <section class="panel p-6">
          <p style="font-family: var(--font-sans); color: var(--fg);">
            This register has not been referenced in any Operational Bulletin issue in our records.
          </p>
        </section>
      )}
      {recommendation && (
        <p class="mt-4" style="font-family: var(--font-sans);">
          <a href={`/recommendations/${recommendation}/`} class="tint">
            → See Recommendation ITU-T {recommendation}
          </a>
        </p>
      )}
    </>
  ) : (
    <>
      <TimelineScrubber
        slug={slug!}
        touchedIssues={manifest.touched_issues}
        currentIssue={null}
        seedIssue={manifest.seed_issue}
      />

      <p class="mb-4 text-[var(--step--1)]">
        <a href={`/registers/${slug}/history/`} class="no-underline hover:underline" style="color: var(--accent);">
          → View full change history ({state.history.length} patches)
        </a>
      </p>

      {/* Issue cross-reference archive for parity */}
      <IssueArchive />

      {manifest && state && state.history.length > 0 && (
        <RegisterHistory
          slug={slug!}
          keyField={manifest.key_field}
          seedIssue={manifest.seed_issue}
          history={state.history}
        />
      )}

      <section>
        <header class="rule-thin pt-4 mb-5">
          <h3 class="text-[var(--step-3)]" style="font-family: var(--font-display); font-weight: 600;">
            Current entries
          </h3>
        </header>
        {state && <RegisterTable state={state} keyField={manifest?.key_field ?? ""} />}
      </section>
    </>
  )}
</Base>
