---
/**
 * Search page: client-side filter over the build-time /cmdk-index.json.
 */
import Base from "~/layouts/Base.astro";
---
<Base title="Search" description="Search the ITU Operational Bulletin.">
  <main id="main" class="mx-auto max-w-[var(--measure)] px-4 py-8">
    <h1 class="text-[var(--step-3)] mb-4" style="font-family: var(--font-display); font-weight: 700;">
      Search
    </h1>
    <p class="text-[var(--step--1)] mb-6" style="color: var(--fg-muted); font-family: var(--font-sans);">
      Basic search over issues, datasets, registers, recommendations and downloads.
      Looking for a PDF? See <a href="/downloads/" class="underline">Downloads</a>.
    </p>
    <form id="search-form" role="search" class="mb-4">
      <input id="search-input" type="search" name="q" autocomplete="off" aria-label="Search"
        class="w-full px-3 py-2 border" style="font-family: var(--font-sans);" />
    </form>
    <p id="search-status" role="status" style="color: var(--fg-muted);"></p>
    <ul id="search-results" class="space-y-2"></ul>
  </main>

  <script>
    import { filterEntries, type SearchEntry } from "~/lib/search-filter";

    const input = document.getElementById("search-input") as HTMLInputElement;
    const status = document.getElementById("search-status")!;
    const list = document.getElementById("search-results")!;
    let index: SearchEntry[] | null = null;

    async function run() {
      const q = input.value.trim();
      list.replaceChildren();
      if (!q) { status.textContent = ""; return; }
      if (!index) {
        try {
          index = (await (await fetch("/cmdk-index.json")).json()) as SearchEntry[];
        } catch {
          status.textContent = "Search index could not be loaded.";
          return;
        }
        // A newer keystroke ran while the index loaded; it owns the list now.
        if (input.value.trim() !== q) return;
        list.replaceChildren();
      }
      const hits = filterEntries(index, q);
      status.textContent = hits.length ? `${hits.length} result${hits.length === 1 ? "" : "s"}` : `No results for "${q}".`;
      for (const h of hits.slice(0, 100)) {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = h.href;
        a.className = "underline";
        a.textContent = h.label;
        li.append(a);
        if (h.meta) {
          const m = document.createElement("span");
          m.style.color = "var(--fg-muted)";
          m.textContent = ` ${h.meta}`;
          li.append(m);
        }
        list.append(li);
      }
    }

    document.getElementById("search-form")!.addEventListener("submit", (e) => {
      e.preventDefault();
      const url = new URL(location.href);
      url.searchParams.set("q", input.value.trim());
      history.replaceState(null, "", url);
      run();
    });
    input.addEventListener("input", run);
    input.value = new URLSearchParams(location.search).get("q") ?? "";
    run();
  </script>
</Base>
