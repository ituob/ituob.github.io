---
/**
 * Search results page — powered by Pagefind.
 * Pagefind generates the /pagefind/ directory at build time.
 */
import Base from "~/layouts/Base.astro";
---
<Base title="Search" description="Search the ITU Operational Bulletin.">
  <style>
    /* Pagefind UI, tuned to the site palette. */
    :root {
      --pagefind-ui-primary: #1285b1;
      --pagefind-ui-text: #0c3d52;
      --pagefind-ui-background: #ffffff;
      --pagefind-ui-border: #d8e4ea;
      --pagefind-ui-tag: #f2f7f9;
      --pagefind-ui-border-width: 1px;
      --pagefind-ui-border-radius: 6px;
      --pagefind-ui-image-border-radius: 6px;
      --pagefind-ui-font: Helvetica, Arial, sans-serif;
    }
  </style>
  <main id="main" class="mx-auto max-w-[var(--measure)] px-4 py-8">
    <h1 class="text-[var(--step-3)] mb-4" style="font-family: var(--font-display); font-weight: 700;">
      Search
    </h1>
    <p class="text-[var(--step--1)] mb-6" style="color: var(--fg-muted); font-family: var(--font-sans);">
      Search across all ITU Operational Bulletin issues, datasets, and recommendations.
    </p>
    <div id="search-root">
      <p style="color: var(--fg-muted); font-style: italic;">
        Search index loads after the page renders. If this persists, the index may not be built yet.
      </p>
    </div>
  </main>

  <script is:inline>
    (async () => {
      var el = document.getElementById("search-root");
      try {
        var path = "/page" + "find/page" + "find-ui.js";
        var mod = await import(path);
        new mod.PagefindUI({
          element: "#search-root",
          showImages: false,
          pageSize: 10,
        });
        var q = new URLSearchParams(location.search).get("q");
        var input = document.querySelector("#search-root input");
        if (q && input) {
          input.value = q;
          input.dispatchEvent(new Event("input", { bubbles: true }));
        } else if (input) {
          input.focus();
        }
      } catch (e) {
        if (el) {
          el.innerHTML = "<p style='color: var(--fg-muted); font-style: italic;'>Search index not yet generated. Run <code>npm run build</code> with Pagefind enabled.</p>";
        }
      }
    })();
  </script>
</Base>
