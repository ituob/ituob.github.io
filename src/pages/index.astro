---
/**
 * Home page — mirrors the original ituob.org home (Jekyll index.html):
 * about/warning panel, current issue, publication amendments, recommendation
 * filter, and the issue archive. No invented sections.
 */
import Base from "~/layouts/Base.astro";
import {
  listIssueIds,
  loadIssue,
  loadRegisterCatalog,
  buildRecommendationIndex,
} from "~/lib/loaders";
import { formatSwissDate, slugifyRecCode } from "~/lib/format";
import { PUBLICATION_BY_SLUG, OB_ISSN, SUPPORTED_LANGUAGES } from "~/lib/catalogs";
import { availableLanguages } from "~/lib/i18n";
import { obIssuesRoot, readYamlOrNull, join } from "~/lib/fs";

const ids = listIssueIds();
const latestId = ids[ids.length - 1]!;
const latest = loadIssue(latestId);
const latestHref = "/issues/" + latestId + "/";

const registers = loadRegisterCatalog();
const recIndex = buildRecommendationIndex();

// Amendment occurrences per ob-issues slug, and the latest annex position
// per register id, scanned once across the whole corpus.
const occurrences = new Map<string, number[]>();
const lastPosition = new Map<string, string>();
for (const id of ids) {
  const issue = loadIssue(id);
  if (!issue) continue;
  const slugs = new Set([
    ...Object.keys(issue.amendments.structured),
    ...Object.keys(issue.amendments.textual),
    ...Object.keys(issue.amendments.placeholder),
  ]);
  for (const s of slugs) {
    const arr = occurrences.get(s) ?? [];
    arr.push(id);
    occurrences.set(s, arr);
  }
  const ax = readYamlOrNull<Record<string, { position_on?: string | Date }>>(
    join(obIssuesRoot(), String(id), "annexes.yaml"),
  );
  if (ax) {
    for (const [pubId, entry] of Object.entries(ax)) {
      if (entry && entry.position_on) {
        lastPosition.set(pubId, String(entry.position_on));
      }
    }
  }
}

interface PublicationRow {
  slug: string;
  title: string;
  recommendation: string | null;
  href: string;
  position: string | null;
  count: number;
  latestId: number;
  latestDate: string;
}

// Publications with at least one amendment, in register-catalog order —
// the original home's "View publication amendments" section.
const publications: PublicationRow[] = [];
for (const reg of registers) {
  const issueIds = occurrences.get(reg.slug);
  if (!issueIds || issueIds.length === 0) continue;
  const latestAmd = issueIds[issueIds.length - 1]!;
  const issue = loadIssue(latestAmd);
  const known = PUBLICATION_BY_SLUG.get(reg.slug);
  const title = reg.title?.en ?? known?.label ?? reg.register_id;
  const recommendation = reg.recommendation ?? known?.recommendation ?? null;
  const position = lastPosition.get(reg.register_id) ?? null;
  publications.push({
    slug: reg.slug,
    title,
    recommendation,
    href: "/registers/" + reg.slug + "/",
    position: position ? formatSwissDate(position) : null,
    count: issueIds.length,
    latestId: latestAmd,
    latestDate: formatSwissDate(issue?.meta.publication_date),
  });
}

// Recommendation filter — unique codes in publication order.
const recommendations: string[] = [];
for (const p of publications) {
  if (p.recommendation && !recommendations.includes(p.recommendation)) {
    recommendations.push(p.recommendation);
  }
}

// Languages present in the current issue.
const LANG_NAMES: Record<string, string> = {
  en: "English",
  fr: "French",
  es: "Spanish",
  ru: "Russian",
  zh: "Chinese",
  ar: "Arabic",
};
// Languages with actual content (same rule as /issues/[id]/[lang]:
// English lives at /issues/{id}/ and never gets an /en/ route).
const langsAvail = new Set<string>();
for (const m of latest?.general.textual ?? []) {
  for (const l of availableLanguages(m.contents)) langsAvail.add(l);
}
for (const amd of Object.values(latest?.amendments.textual ?? {})) {
  for (const l of availableLanguages(amd.contents)) langsAvail.add(l);
}
const latestLangs = SUPPORTED_LANGUAGES.filter((l) => langsAvail.has(l));
const langList: readonly string[] = latestLangs.length > 0 ? latestLangs : ["en"];

// Quick access: the registers people look up most, in printed order.
const QUICK_SLUGS = ["e118-iin", "e212-mnc", "e164-cc", "q708-ispc"] as const;
const quickRegisters = QUICK_SLUGS
  .map((s) => registers.find((r) => r.slug === s))
  .filter((r): r is NonNullable<typeof r> => Boolean(r))
  .map((r) => ({ slug: r.slug, title: r.title?.en ?? r.register_id }));

// Issue archive: years (descending) with their issue ids.
const byYear = new Map<number, number[]>();
for (const id of ids) {
  const issue = loadIssue(id);
  const iso = issue?.meta?.publication_date;
  if (!iso) continue;
  const year = Number.parseInt(iso.slice(0, 4), 10);
  const arr = byYear.get(year) ?? [];
  arr.push(id);
  byYear.set(year, arr);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---
<Base
  title="ITU Operational Bulletin online"
  full
  description="ITU Operational Bulletin — the cross-bureau biweekly publication of the International Telecommunication Union."
>
  {/* STATUS — one line; the full notice is under About at the end. */}
  <p style="margin: 0 0 1.25rem; font-size: 0.85rem; color: #666;">
    An unofficial, unvalidated reader for the ITU Operational Bulletin. For
    authoritative use, refer to the{" "}
    <a href="https://www.itu.int/pub/T-SP" rel="external">official ITU issues</a>.
  </p>

  {/* FIND — the first action on the page */}
  <section style="margin-bottom: 2rem;">
    <form action="/search/" method="get" role="search" style="display: flex; gap: 0.5rem; max-width: 34rem;">
      <input
        type="search"
        name="q"
        placeholder="Find a country, an operator, a number…"
        aria-label="Search the Bulletin"
        style="flex: 1; padding: 0.55rem 0.8rem; font-size: 1rem; border: 1px solid #bbb; border-radius: 6px; font-family: var(--font-sans);"
      />
      <button
        type="submit"
        style="padding: 0.55rem 1.1rem; font-size: 1rem; background: #1aa1da; color: #fff; border: 0; border-radius: 6px; cursor: pointer; font-weight: 600; font-family: var(--font-sans);"
      >
        Search
      </button>
    </form>
    <div style="display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; margin-top: 0.85rem; font-size: 0.95rem;">
      {quickRegisters.map((r) => (
        <a href={"/registers/" + r.slug + "/"} style="color: #1aa1da;">{r.title}</a>
      ))}
    </div>
  </section>

  {/* CURRENT ISSUE */}
  <section style="margin-bottom: 2rem;">
    <header style="display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap;">
      <h2 style="font-size: 2rem; margin: 0; font-weight: 700;">
        <a href={latestHref} style="color: inherit; text-decoration: none;">No. {latestId}</a>
      </h2>
      <p style="margin: 0; color: #666; font-size: 0.9rem;">
        includes updates up until {formatSwissDate(latest?.meta.cutoff_date)}
      </p>
    </header>
    <p style="margin: 0.75rem 0 0; font-size: 0.9rem;">
      Read this issue in{" "}
      {langList.map((l, i) => (
        <>
          {i > 0 && ", "}
          <a href={l === "en" ? latestHref : "/issues/" + latestId + "/" + l + "/"}>
            {LANG_NAMES[l] ?? l}
          </a>
        </>
      ))}
      <span style="color: #999;"> · ISSN {latest?.meta.issn ?? OB_ISSN}</span>
    </p>
  </section>

  {/* VIEW PUBLICATION AMENDMENTS — original section semantics */}
  <section style="margin-bottom: 2rem;">
    <h2 style="color: #df314e; font-weight: 700; text-transform: uppercase; font-size: 80%; letter-spacing: 0.04em; margin: 0 0 0.75rem;">
      View publication amendments
    </h2>
    {publications.map((p) => (
      <article style="margin-bottom: 1rem;">
        <h3 style="margin: 0; font-weight: normal; font-size: 1rem;">
          <a href={p.href}>{p.title}</a>
        </h3>
        <div style="display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; margin-top: 0.25rem; font-size: 90%; color: #333;">
          {p.position && <span>Position on {p.position}</span>}
          <span>
            Amended {p.count} time{p.count === 1 ? "" : "s"}, latest{" "}
            <a href={"/issues/" + p.latestId + "/"} style="color: #333;">{p.latestDate}</a>
          </span>
        </div>
      </article>
    ))}
  </section>

  {/* FILTER MESSAGES BY RECOMMENDATION — original section */}
  <section style="margin-bottom: 2rem;">
    <h2 style="color: #df314e; font-weight: 700; text-transform: uppercase; font-size: 80%; letter-spacing: 0.04em; margin: 0 0 0.75rem;">
      Filter messages by recommendation
    </h2>
    <div style="display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem;">
      {recommendations.map((rec) => (
        <a href={"/recommendations/" + slugifyRecCode(rec) + "/"} style="font-size: 0.95rem;">
          {rec}
        </a>
      ))}
      {recIndex.size === 0 && <span style="color: #666;">No recommendations indexed.</span>}
    </div>
  </section>

  {/* VIEW OLDER ISSUES — original archive */}
  <section style="margin-bottom: 2rem;">
    <h2 style="color: #df314e; font-weight: 700; text-transform: uppercase; font-size: 80%; letter-spacing: 0.04em; margin: 0 0 0.75rem;">
      View older issues
    </h2>
    <ul style="list-style: none; padding: 0; margin: 0; font-size: 90%; line-height: 1.9;">
      {years.map((year) => (
        <li>
          <strong>{year}</strong>:
          {"  "}
          {byYear.get(year)!.map((id, i) => (
            <>
              {i > 0 && "  "}
              <a href={"/issues/" + id + "/"}>{id}</a>
            </>
          ))}
        </li>
      ))}
    </ul>
  </section>

  {/* ABOUT — original Jekyll wording, collapsed */}
  <section style="background: #f5f5f5; padding: 1rem 1rem 0; margin: 0 0 1.5rem; border-radius: 6px;">
    <details>
      <summary
        style="cursor: pointer; color: #1aa1da; font-weight: 600; margin-bottom: 1rem;"
      >
        About ITU OB Online
      </summary>
      <div style="padding-bottom: 1rem;">
        <p style="margin: 0 0 1rem;">
          <strong>WARNING:</strong> This website is not an official ITU resource. The data on this
          website has not been validated. Users of the ITU Operational Bulletin are encouraged to
          refer to the official ITU Operational Bulletin issues.
        </p>
        <p style="margin: 0 0 1rem;">
          ITU Operational Bulletin is the medium for the exchange of information on changes in
          international telecommunication networks and services. Each issue includes
          informational notices and amendments to ITU Service Publications. (Read more about{" "}
          <a href="https://www.itu.int/pub/T-SP" rel="external">ITU OB</a>.)
        </p>
        <p style="margin: 0 0 1rem;">
          <em>ITU OB Online</em> is an effort to make the ITU Operational Bulletin messages and
          associated Service Publications easier to view &amp; navigate via fully-featured Web
          interface and machine-readable APIs.
        </p>
        <p style="margin: 0 0 1rem;">
          While the information is being filled in, some issues of ITU OB and ITU Service
          Publications may be missing here. In such cases please refer to{" "}
          <a href="https://www.itu.int/pub/T-SP" rel="external">authoritative ITU OB resource</a>{" "}
          on ITU website.
        </p>
      </div>
    </details>
  </section>
</Base>
