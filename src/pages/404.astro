---
import Base from "~/layouts/Base.astro";
---
<Base title="Not found" description="Page not found.">
  <header class="mb-8">
    <p class="uppercase font-semibold" style="font-family: var(--font-sans); font-size: var(--step--1); letter-spacing: 0.1em; color: var(--accent);">
      Error 404
    </p>
    <h1 class="mt-1" style="font-family: var(--font-display); font-size: var(--step-5); font-weight: 700;">
      Not found
    </h1>
  </header>
  <p class="measure prose-bulletin">
    The page you requested does not exist. Try the
    <a href="/issues/">issue archive</a>, the
    <a href="/datasets/">list of datasets</a>, or return to the
    <a href="/">home page</a>.
  </p>
  <form action="/search/" method="get" role="search" class="mt-6 flex gap-2" style="max-width: 30rem;">
    <input
      type="search"
      name="q"
      placeholder="Search the Bulletin"
      aria-label="Search the Bulletin"
      style="flex: 1; padding: 0.55rem 0.8rem; font-size: 1rem; border: 1px solid #bbb; border-radius: 6px; font-family: var(--font-sans);"
    />
    <button
      type="submit"
      style="padding: 0.55rem 1.1rem; font-size: 1rem; background: #1aa1da; color: #fff; border: 0; border-radius: 6px; cursor: pointer; font-weight: 600; font-family: var(--font-sans);"
    >
      Search
    </button>
  </form>
</Base>
