---
import Base from "~/layouts/Base.astro";
import {
  loadIssue,
  listIssueIds,
  loadDatasetMetadata,
  loadListMetadata,
  cumulativeAmendmentNumber,
  loadRegisterCatalog,
  lastAnnexBefore,
  loadGeneralAdoc,
  datasetPageHref,
  issuePageHref,
} from "~/lib/loaders";
import { formatSwissDate } from "~/lib/format";
import {
  MESSAGE_TYPE_ORDER,
  GENERAL_TYPE_LABELS,
  PUBLICATION_BY_SLUG,
  type GeneralMessageType,
  type Language,
} from "~/lib/catalogs";
import RunningAnnexes from "~/components/RunningAnnexes.astro";
import ApprovedRecommendations from "~/components/ApprovedRecommendations.astro";
import IncompleteBanner from "~/components/IncompleteBanner.astro";
import TextualMessage from "~/components/TextualMessage.astro";
import AdocText from "~/components/AdocText.astro";
import TelephoneService from "~/components/TelephoneService.astro";
import ServiceRestrictions from "~/components/ServiceRestrictions.astro";
import StructuredAmendment from "~/components/StructuredAmendment.astro";
import TextualAmendment from "~/components/TextualAmendment.astro";
import type { TextualGeneralMessage } from "~/lib/types";

export function getStaticPaths() {
  return listIssueIds().map((id) => ({ params: { id: String(id) } }));
}

const { id: idStr } = Astro.params;
const id = Number.parseInt(idStr!, 10);
const issue = loadIssue(id);
if (!issue) {
  return Astro.redirect("/404");
}

const lang: Language = "en";

const presentGeneralTypes = MESSAGE_TYPE_ORDER.filter((t) => {
  if (t === "running_annexes") return issue.general.runningAnnexes !== null;
  if (t === "approved_recommendations") return issue.general.approvedRecommendations !== null;
  return issue.general.textual.some((m) => m.type === t);
});

const textualByType = new Map<GeneralMessageType, TextualGeneralMessage[]>();
for (const m of issue.general.textual) {
  const arr = textualByType.get(m.type) ?? [];
  arr.push(m);
  textualByType.set(m.type, arr);
}

// A few messages normalize as references to an AsciiDoc asset
// (contents: "general/<file>.adoc"); their text is loaded from the
// corpus at build time.
const adocTextFor = (m: TextualGeneralMessage): string | null => {
  const contents = m.contents as unknown;
  if (typeof contents !== "string" || !contents.endsWith(".adoc")) return null;
  return loadGeneralAdoc(id, contents);
};

const amendmentSlugs = [
  ...new Set([
    ...Object.keys(issue.amendments.structured),
    ...Object.keys(issue.amendments.textual),
    ...Object.keys(issue.amendments.placeholder),
    ...loadRegisterCatalog()
      .filter((r) => r.seed_issue === id && !r.external)
      .map((r) => r.slug),
  ]),
].sort();

// Planned issues: the next ~25 issues after this one.
const allIds = listIssueIds();
const idx = allIds.indexOf(id);
const upcomingIssues = allIds
  .slice(idx + 1, idx + 26)
  .map((uid) => {
    const u = loadIssue(uid);
    return u ? { id: uid, publication_date: u.meta.publication_date, cutoff_date: u.meta.cutoff_date } : null;
  })
  .filter((u): u is NonNullable<typeof u> => u !== null);

// ---- Original issue-page structure (Jekyll _layouts/issue.html) ----
interface GeneralMessageItem {
  type: GeneralMessageType;
  anchorId: string;
  title: string;
}
const generalList: GeneralMessageItem[] = [];
{
  let n = 0;
  for (const t of MESSAGE_TYPE_ORDER) {
    if (!presentGeneralTypes.includes(t)) continue;
    n += 1;
    const customTitle =
      t === "custom" && textualByType.has(t)
        ? (textualByType.get(t)![0] as { title?: { en?: string } })?.title?.en
        : null;
    generalList.push({ type: t, anchorId: "general-" + n, title: customTitle ?? GENERAL_TYPE_LABELS[t] });
  }
}

interface AmendmentItem {
  anchorId: string;
  slug: string;
  amdNo: number;
  title: string;
  datasetHref: string | null;
  recCode: string | null;
  recVersion: string | null;
  annexIssueId: number | null;
  annexHref: string | null;
  annexDate: string | null;
  hasStructured: boolean;
  hasTextual: boolean;
  hasPlaceholder: boolean;
}
const amendmentsList: AmendmentItem[] = [];
{
  let n = 0;
  for (const slug of amendmentSlugs) {
    n += 1;
    const known = PUBLICATION_BY_SLUG.get(slug);
    const meta = loadDatasetMetadata(slug);
    const registerEntry = loadRegisterCatalog().find((r) => r.slug === slug);
    const listMeta = known?.publicationId ? loadListMetadata(known.publicationId) : null;
    const title =
      listMeta?.title?.en ?? meta?.title?.en ?? registerEntry?.title?.en ?? known?.label ?? slug;
    const recCode =
      listMeta?.recommendation?.code ?? meta?.recommendation?.code ?? known?.recommendation ?? registerEntry?.recommendation ?? null;
    const recVersion = listMeta?.recommendation?.version ?? meta?.recommendation?.version ?? null;
    const annexRef = known?.publicationId ? lastAnnexBefore(id, known.publicationId) : null;
    amendmentsList.push({
      anchorId: "amendments-" + n,
      slug,
      amdNo: cumulativeAmendmentNumber(id, slug),
      title,
      datasetHref: datasetPageHref(slug),
      recCode,
      recVersion,
      annexIssueId: annexRef ? annexRef.issueId : null,
      annexHref: annexRef ? issuePageHref(annexRef.issueId) : null,
      annexDate: annexRef?.positionOn ? formatSwissDate(annexRef.positionOn) : null,
      hasStructured: Boolean(issue.amendments.structured[slug]),
      hasTextual: Boolean(issue.amendments.textual[slug]),
      hasPlaceholder: Boolean(issue.amendments.placeholder[slug]),
    });
  }
}

const authorLabel: Record<string, string> = { phone: "Tel:", fax: "Fax:", email: "Email:" };
const authoritativeHref =
  "https://www.itu.int/pub/T-SP-OB." + id + "-" + String(issue.meta.publication_date).slice(0, 4);
---
<Base
  title={"No. " + id}
  bodyClass="layout--issue"
  bareMain
  description={"ITU Operational Bulletin No. " + id + ", published " + formatSwissDate(issue.meta.publication_date) + "."}
  extraStylesheets={["/assets/css/issue.css"]}
  headScripts={["https://kit.fontawesome.com/3ebc4b9810.js"]}
>
  {issue.incomplete && <IncompleteBanner />}

  <header>
    <h1 class="bulletin-title">
      <a href="https://www.itu.int/itu-t/bulletin/">ITU Operational Bulletin</a>
    </h1>

    <section class="meta-row publication">
      <h2 class="seq-no">No. <span class="value">{id}</span></h2>
      <div class="publication-date">{formatSwissDate(issue.meta.publication_date)}</div>
      <div class="other">
        <span class="cutoff-date">Information&nbsp;received&nbsp;by {formatSwissDate(issue.meta.cutoff_date)}</span>
        {" "}
        <span class="issn">ISSN {issue.meta.issn}</span>
        {" "}(Online)
      </div>
    </section>

    <section class="meta-row authors">
      {(issue.meta.authors ?? []).map((author) => (
        <article class="author">
          {author.name && <strong class="name">{author.name}</strong>}
          {author.address && <span class="address" set:html={author.address.replace(/\n/g, "<br />")} />}
          {author.contacts?.map((ct) => (
            <span class={`contact-entry contact-${ct.type}`}>
              <span class="contact-label">{authorLabel[ct.type] ?? ct.type}</span>
              <span class="contact-data">{ct.data}</span>
            </span>
          ))}
        </article>
      ))}
    </section>
  </header>

  <nav class="toc">
    <p class="authoritative-resource">
      <i class="fas fa-home"></i>
      {" "}See{" "}
      <a href={authoritativeHref}>the authoritative resource for this edition of ITU Operational Bulletin</a>
      {" "}on ITU website.
    </p>
    <ul>
      <li>
        <a href="#general">General Information</a>
        {generalList.length > 0 && (
          <ul>
            {generalList.map((g) => (
              <li><a href={"#" + g.anchorId}>{g.title}</a></li>
            ))}
          </ul>
        )}
      </li>
      {amendmentsList.length > 0 && (
        <li>
          <a href="#amendments">Amendments</a>
          <ul>
            {amendmentsList.map((a) => (
              <li><a href={"#" + a.anchorId}>{a.title}</a></li>
            ))}
          </ul>
        </li>
      )}
    </ul>
    <p class="toc-expand">
      <button type="button" id="expand-all" aria-pressed="false">Expand all messages</button>
    </p>
  </nav>

  {upcomingIssues.length > 0 && (
    <section class="planned-issues">
      <h3>Dates of publication of the next Operational Bulletins</h3>
      <table>
        <thead>
          <tr>
            <th class="seq-no">No.</th>
            <th class="publication-date">Publication date</th>
            <th class="cutoff-date">Including information received by</th>
          </tr>
        </thead>
        <tbody>
          {upcomingIssues.map((u) => (
            <tr>
              <td>{u.id}</td>
              <td>{formatSwissDate(u.publication_date)}</td>
              <td>{formatSwissDate(u.cutoff_date)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}

  <section class="general-information" id="general">
    <h3>General information</h3>
    {generalList.map((g) => {
      const t = g.type;
      return (
        <details class={`message message--${t}`} id={g.anchorId}>
          <summary class="msg-summary">
            <h3 class="title">
              <span class="text">{g.title}</span>
              <a class="anchor" title="Link to this message"
                 href={`/issues/${id}/#${g.anchorId}`}>#</a>
            </h3>
          </summary>
          <div class="included-contents">
            {t === "running_annexes" && issue.general.runningAnnexes && <RunningAnnexes issue={issue} />}
            {t === "approved_recommendations" && issue.general.approvedRecommendations && (
              <ApprovedRecommendations message={issue.general.approvedRecommendations} />
            )}
            {textualByType.has(t) && textualByType.get(t)!.map((m) => (
              <>
                {t === "service_restrictions" && Array.isArray((m as unknown as { items?: unknown }).items) ? (
                  <ServiceRestrictions items={(m as unknown as { items: never[] }).items} lang={lang} />
                ) : t === "telephone_service_2" && Array.isArray((m as unknown as { contents?: unknown }).contents) ? (
                  <TelephoneService contents={(m as unknown as { contents: never[] }).contents} lang={lang} />
                ) : adocTextFor(m) ? (
                  <AdocText text={adocTextFor(m) ?? ""} />
                ) : (
                  <TextualMessage message={m} lang={lang} />
                )}
              </>
            ))}
          </div>
        </details>
      );
    })}
  </section>

  {amendmentsList.length > 0 && (
    <section class="amendments" id="amendments">
      <h3>Amendments</h3>
      <section class="legend">
        <h4>Abbreviations used in this section</h4>
        <dl class="inline-dl">
          <dt>ADD</dt> <dd>Insert</dd>
          <dt>PAR</dt> <dd>Paragraph</dd>
          <dt>COL</dt> <dd>Column</dd>
          <dt>REP</dt> <dd>Replace</dd>
          <dt>LIR</dt> <dd>Read</dd>
          <dt>SUP</dt> <dd>Delete</dd>
          <dt>P</dt> <dd>Page(s)</dd>
        </dl>
      </section>

      {amendmentsList.map((a) => (
        <details class="message message--amendment" id={a.anchorId}>
          <summary class="msg-summary">
            <h3 class="title">
              <span class="label" title="Amendment">
                Amd.
                {a.amdNo > 0 && <span class="num"> {a.amdNo}</span>}
                {" "}to
              </span>
              {a.datasetHref ? (
                <a class="text" href={a.datasetHref}>{a.title}</a>
              ) : (
                <span class="text">{a.title}</span>
              )}
              <a class="anchor" title="Link to this message"
                 href={`/issues/${id}/#${a.anchorId}`}>#</a>
            </h3>
            {a.recCode && (
              <span class="recommendation">
                In accordance with{" "}
                <span class="std-label">
                  <span class="std-body">ITU-T</span>{" "}
                  <span class="std-type">Recommendation</span>{" "}
                  <span class="std-id">{a.recCode}{a.recVersion ? ` (${a.recVersion})` : ""}</span>
                </span>
              </span>
            )}
            {a.annexIssueId && (
              <span class="annex-to-ob">
                Position originally published as annex to{" "}
                {a.annexHref ? (
                  <a href={a.annexHref}>ITU Operational Bulletin No. {a.annexIssueId}</a>
                ) : (
                  <span>ITU Operational Bulletin No. {a.annexIssueId}</span>
                )}
                {a.annexDate && <span> — {a.annexDate}</span>}
              </span>
            )}
          </summary>
          <div class="included-contents">
            {a.hasStructured && issue.amendments.structured[a.slug] && (
              <StructuredAmendment amendments={issue.amendments.structured[a.slug]!} lang={lang} />
            )}
            {a.hasTextual && issue.amendments.textual[a.slug] && (
              <TextualAmendment amendment={issue.amendments.textual[a.slug]} lang={lang} />
            )}
            {a.hasPlaceholder && issue.amendments.placeholder[a.slug] && (
              <TextualAmendment placeholder={issue.amendments.placeholder[a.slug]} />
            )}
          </div>
        </details>
      ))}
    </section>
  )}

  <script is:inline src="/assets/js/issue-nav.js"></script>
  <script is:inline>
    (function () {
      var button = document.getElementById("expand-all");
      var cards = Array.prototype.slice.call(document.querySelectorAll("details.message"));
      if (!button || cards.length === 0) return;

      function setLabel() {
        var allOpen = cards.every(function (card) { return card.open; });
        button.textContent = allOpen ? "Collapse all messages" : "Expand all messages";
        button.setAttribute("aria-pressed", allOpen ? "true" : "false");
      }

      button.addEventListener("click", function () {
        var open = !cards.every(function (card) { return card.open; });
        cards.forEach(function (card) { card.open = open; });
        setLabel();
      });
      cards.forEach(function (card) { card.addEventListener("toggle", setLabel); });
      setLabel();

      cards.forEach(function (card) {
        card.querySelectorAll("summary a").forEach(function (link) {
          link.addEventListener("click", function (event) { event.stopPropagation(); });
        });
      });

      function openTarget() {
        if (!location.hash) return;
        var el = document.getElementById(decodeURIComponent(location.hash.slice(1)));
        if (el && el.tagName === "DETAILS") {
          el.open = true;
          el.scrollIntoView({ block: "start" });
        }
      }
      window.addEventListener("hashchange", openTarget);
      openTarget();
    })();
  </script>
</Base>
