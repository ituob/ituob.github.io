---
import Base from "~/layouts/Base.astro";
import DownloadStatus from "~/components/DownloadStatus.astro";
import { REGISTERS } from "~/lib/catalogs";
import { groupPublications, loadPublications, pdfHref } from "~/lib/publications";

const { entries } = loadPublications();
const groups = groupPublications(entries);
const knownRegisters = new Set(REGISTERS.map((r) => r.slug));
---
<Base breadcrumbs={[{ label: "Downloads" }]} title="Downloads" description="Downloadable PDF editions of the ITU service publications, generated from the Operational Bulletin patch log.">
  <header class="mb-10">
    <p class="uppercase font-semibold" style="font-family: var(--font-sans); font-size: var(--step--1); letter-spacing: 0.1em; color: var(--accent);">
      Publications
    </p>
    <h1 class="mt-1" style="font-family: var(--font-display); font-size: var(--step-5); font-weight: 700;">
      Downloads
    </h1>
    <p class="mt-2 text-[var(--step-0)]" style="color: var(--fg-muted);">
      PDF editions of the service publications, by Recommendation and edition. Each file states
      the Bulletin issue whose state it represents.
    </p>
  </header>

  {groups.length === 0 && (
    <p style="color: var(--fg-muted);">No PDF editions are published yet.</p>
  )}

  {groups.map((g) => (
    <section class="mb-10" aria-labelledby={`dl-${g.standard}`}>
      <h2 id={`dl-${g.standard}`} class="mb-3" style="font-family: var(--font-display); font-size: var(--step-2); font-weight: 700;">
        ITU-T {g.standard}
      </h2>
      {g.editions.map((ed) => (
        <article class="mb-6 pb-4" style="border-bottom: 1px solid var(--border, currentColor);" data-edition={`${ed.standard}-${ed.edition_year}`} data-edition-article data-status={ed.status}>
          <h3 style="font-size: var(--step-1); font-weight: 600;">
            {ed.title} <span class="num" style="color: var(--fg-muted);">({ed.edition_year} edition)</span>
          </h3>
          <div class="mt-2"><DownloadStatus status={ed.status} /></div>
          {ed.register_slugs.length > 0 && (
            <p class="mt-2" style="font-size: var(--step--1); color: var(--fg-muted);">
              Registers covered:{" "}
              {ed.register_slugs.map((slug, i) => (
                <>
                  {i > 0 && ", "}
                  {knownRegisters.has(slug)
                    ? <a href={`/registers/${slug}/`} class="underline">{slug}</a>
                    : <span>{slug}</span>}
                </>
              ))}
            </p>
          )}
          <ul class="mt-3 flex flex-wrap gap-2" aria-label="Language editions">
            {ed.entries.map((e) => (
              <li>
                <a href={pdfHref(e)} download data-file data-standard={e.standard} data-edition-year={e.edition_year} data-language={e.language} data-sha256={e.sha256} class="inline-flex items-center gap-2 px-3 py-1 rounded no-underline" style="border: 1px solid var(--accent); font-family: var(--font-sans); font-size: var(--step--1);" lang={e.language} title={`SHA-256 ${e.sha256}`}>
                  <span class="uppercase font-semibold">{e.language}</span>
                  <span style="color: var(--fg-muted);">PDF · as of OB No. {e.as_of_issue}</span>
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </section>
  ))}
</Base>

<script>
  // ITU adoption overlay (#106). The page is built as "candidate"; an edition is
  // upgraded only when a live adoption record matches every file's sha256.
  // Any failure leaves the candidate wording in place.
  import { editionAdopted, type AdoptionKey } from "~/lib/adoption";
  (async () => {
    try {
      const res = await fetch("/api/publications/adoptions", { credentials: "omit" });
      if (!res.ok) return;
      const records = ((await res.json()) as { adoptions: AdoptionKey[] }).adoptions;
      document.querySelectorAll<HTMLElement>("[data-edition-article]").forEach((article) => {
        const files = [...article.querySelectorAll<HTMLElement>("[data-file]")].map((a) => ({
          standard: a.dataset.standard ?? "",
          edition_year: Number(a.dataset.editionYear),
          language: a.dataset.language ?? "",
          sha256: a.dataset.sha256 ?? "",
        }));
        if (!editionAdopted(files, records)) return;
        const box = article.querySelector<HTMLElement>(".download-status");
        const label = box?.querySelector<HTMLElement>(".download-label");
        if (!box || !label) return;
        label.textContent = box.dataset.adoptedLabel ?? "";
        label.style.borderColor = "var(--accent)";
        label.style.color = "var(--accent)";
        box.querySelector(".download-disclaimer")?.remove();
        box.dataset.status = "itu-adopted";
        article.dataset.status = "itu-adopted";
      });
    } catch {
      /* stay candidate */
    }
  })();
</script>
