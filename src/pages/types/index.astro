---
import Base from "~/layouts/Base.astro";
import {
  issuesWithGeneralType,
} from "~/lib/loaders";
import { ALL_GENERAL_TYPES, GENERAL_TYPE_LABELS, STRUCTURED_GENERAL_TYPES } from "~/lib/catalogs";

const types = ALL_GENERAL_TYPES.map((t) => ({
  type: t,
  label: GENERAL_TYPE_LABELS[t],
  structured: STRUCTURED_GENERAL_TYPES.includes(t),
  count: issuesWithGeneralType(t).length,
})).sort((a, b) => b.count - a.count);
---
<Base title="Message types" description="All general message types carried by the ITU Operational Bulletin.">
  <header class="mb-10">
    <p class="uppercase font-semibold" style="font-family: var(--font-sans); font-size: var(--step--1); letter-spacing: 0.1em; color: var(--accent);">
      Cross-issue views
    </p>
    <h1 class="mt-1" style="font-family: var(--font-display); font-size: var(--step-5); font-weight: 700;">
      Message types
    </h1>
    <p class="mt-2 text-[var(--step-0)]" style="color: var(--fg-muted);">
      Every OB issue carries messages in the GENERAL INFORMATION section, classified by type.
      Browse all messages of a given type across the entire run of the Bulletin.
    </p>
  </header>

  <ul class="grid sm:grid-cols-2 gap-3" style="font-family: var(--font-sans);">
    {types.map(({ type, label, structured, count }) => (
      <li>
        <a href={`/types/${type}/`} class="block panel p-4 no-underline hover:border-[var(--accent)]">
          <span class="block font-semibold text-[var(--step-1)]" style="font-family: var(--font-display);">
            {label}
          </span>
          <span class="mt-1 flex items-center gap-2 text-[var(--step--1)]" style="color: var(--fg-muted);">
            <code class="num">{type}</code>
            {structured && <span class="chip">structured</span>}
            <span class="ml-auto num">{count} issues</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</Base>
