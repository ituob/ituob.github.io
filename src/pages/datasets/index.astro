---
import Base from "~/layouts/Base.astro";
import { listDatasetSlugs, loadDatasetMetadata, issuesWithDataset, recommendationHref } from "~/lib/loaders";
import { PUBLICATION_BY_SLUG } from "~/lib/catalogs";

const slugs = listDatasetSlugs();
---
<Base breadcrumbs={[{ label: "Datasets" }]} title="Lists annexed" description="All datasets and lists annexed to the ITU Operational Bulletin.">
  <header class="mb-10">
    <p class="uppercase font-semibold" style="font-family: var(--font-sans); font-size: var(--step--1); letter-spacing: 0.1em; color: var(--accent);">
      Lists annexed
    </p>
    <h1 class="mt-1" style="font-family: var(--font-display); font-size: var(--step-5); font-weight: 700;">
      All datasets
    </h1>
    <p class="mt-2 text-[var(--step-0)]" style="color: var(--fg-muted);">
      {slugs.length} publications with current snapshots, schema definitions and full change histories.
    </p>
  </header>

  <div class="regtable">
    <div class="regtable-tools">
      <input
        type="search"
        class="regtable-find"
        placeholder="Filter the publications"
        aria-label="Filter the publications"
      />
      <span class="regtable-count num" aria-live="polite"></span>
    </div>
    <div class="overflow-x-auto">
      <table class="table-bulletin">
        <caption class="sr-only">ITU Operational Bulletin publications</caption>
        <thead>
          <tr>
          <th style="width: 18rem;">Title</th>
          <th>Slug</th>
          <th>Recommendation</th>
          <th class="num">Issues</th>
        </tr>
      </thead>
      <tbody>
        {slugs.map((slug) => {
          const meta = loadDatasetMetadata(slug);
          const known = PUBLICATION_BY_SLUG.get(slug);
          const title = meta?.title?.en ?? known?.label ?? slug;
          const issueCount = issuesWithDataset(slug).length;
          const recHref = known?.recommendation ? recommendationHref(known.recommendation) : null;
          return (
            <tr>
              <td>
                <a href={`/datasets/${slug}/`} class="no-underline hover:underline font-semibold" style="font-family: var(--font-display);">
                  {title}
                </a>
                {meta?.alias_of && (
                  <span class="ml-2 text-[var(--step--1)]" style="color: var(--fg-subtle);">
                    (alias of {meta.alias_of})
                  </span>
                )}
              </td>
              <td><code class="num text-[var(--step--1)]">{slug}</code></td>
              <td>
                {recHref && <a href={recHref}>ITU-T {known!.recommendation}</a>}
              </td>
              <td class="num">{issueCount}</td>
            </tr>
          );
        })}
      </tbody>
      </table>
    </div>
  </div>

  <style>
    .regtable-tools { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin: 0 0 0.75rem; }
    .regtable-find { flex: 0 1 20rem; padding: 0.45rem 0.7rem; font: inherit; font-size: var(--step--1);
      border: 1px solid var(--border-2); border-radius: 6px; font-family: var(--font-sans); }
    .regtable-count { font-size: var(--step--2); color: var(--fg-subtle); font-family: var(--font-sans); }
  </style>
  <script is:inline src="/assets/js/row-filter.js"></script>
</Base>
