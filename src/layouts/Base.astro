---
/**
 * Base layout — original ituob.org chrome (Jekyll `_layouts/default.html`),
 * adapted to Astro. Header: ITU blue bar, logo pair (hidden per original
 * issue #59 CSS), publication title, breadcrumbs. Footer: pills bar with
 * "Powered by Ribose".
 */
import "~/styles/global.css";
import CommandPalette from "~/components/vue/CommandPalette.vue";
import ReadingProgress from "~/components/vue/ReadingProgress.vue";

export interface Breadcrumb {
  label: string;
  href?: string;
}

export interface Props {
  title: string;
  description?: string;
  masthead?: boolean;
  canonical?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  progress?: boolean;
  lang?: string;
  wide?: boolean;
  full?: boolean;
  breadcrumbs?: Breadcrumb[];
  bodyClass?: string;
  extraStylesheets?: string[];
  headScripts?: string[];
  bareMain?: boolean;
  sections?: { href: string; label: string }[];
}

const {
  title,
  description = "ITU Operational Bulletin — publication of the International Telecommunication Union.",
  masthead: _showMasthead = false,
  canonical,
  ogImage,
  jsonLd,
  progress = false,
  lang = "en",
  wide = false,
  full = false,
  breadcrumbs = [],
  bodyClass = "",
  extraStylesheets = [],
  headScripts = [],
  bareMain = false,
  sections = [
    { href: "/issues/", label: "Issues" },
    { href: "/datasets/", label: "Datasets" },
    { href: "/registers/", label: "Registers" },
    { href: "/recommendations/", label: "Recommendations" },
  ],
} = Astro.props;

const isSection = (href: string) =>
  Astro.url.pathname === href || Astro.url.pathname.startsWith(href);

const siteName = "ITU Operational Bulletin online";
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
const canon = canonical ?? new URL(Astro.url.pathname, Astro.site ?? "https://www.ituob.org").toString();

const isRtl = lang === "ar" || lang === "he" || lang === "fa";
const dir = isRtl ? "rtl" : "ltr";

const containerClass = full ? "container-full" : wide ? "container-wide" : "container-content";

// Site sections (footer navigation). The original footer carried an
// "Editors" pill to /docs/, which does not exist in this build.
const navItems = [
  { href: "/issues/", label: "Issues" },
  { href: "/datasets/", label: "Datasets" },
  { href: "/registers/", label: "Registers" },
  { href: "/recommendations/", label: "Recommendations" },
  { href: "/types/", label: "Message types" },
];
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canon} />
    <meta name="generator" content={Astro.generator} />

    <link href="/assets/favicon-384x384.png" rel="shortcut icon" sizes="384x384" type="image/x-icon" />
    <link href="/assets/favicon.png" rel="shortcut icon" sizes="32x32" type="image/x-icon" />
    <link href="/assets/favicon-384x384.png" rel="apple-touch-icon" />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canon} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    {extraStylesheets.map((href) => <link rel="stylesheet" href={href} />)}
    {headScripts.map((src) => <script is:inline src={src}></script>)}

    {progress && <ReadingProgress client:idle />}
  </head>
  <body class={[`lang--${lang}`, bodyClass].filter(Boolean).join(" ")}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:bg-[var(--accent)] focus:text-[var(--accent-contrast)] focus:px-3 focus:py-1.5 focus:rounded-[var(--radius-sm)]"
    >
      Skip to content
    </a>

    <header class="no-print">
      <div class="bar">
        <a href="/" class="brand" aria-label="ITU Operational Bulletin — home">
          <img src="/assets/logo-inverse.png" alt="ITU" width="34" height="34" />
          <span class="masthead">
            <span class="publication-name">Operational Bulletin</span>
            <span class="online">online</span>
          </span>
        </a>
        <nav class="sections" aria-label="Primary">
          {sections.map((item) => (
            <a href={item.href} aria-current={isSection(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
      {breadcrumbs.length > 0 && (
        <div class="crumbs-strip">
          <div class="crumbs-inner">
            {breadcrumbs.map((crumb, i) => (
              <>
                {i > 0 && <span class="sep" aria-hidden="true">▸</span>}
                {crumb.href ? (
                  <a href={crumb.href}>{crumb.label}</a>
                ) : (
                  <span class="current" aria-current="location">{crumb.label}</span>
                )}
              </>
            ))}
          </div>
        </div>
      )}
    </header>

    <main
      id="main"
      class={bareMain ? undefined : containerClass}
      style={bareMain ? undefined : "padding: clamp(1.5rem, 4vw, 3rem) var(--page-pad) 4rem;"}
    >
      {!bareMain && <h1 class="sr-only">ITU Operational Bulletin</h1>}
      <slot />
    </main>

    <footer class="no-print">
      <nav class="footer-links" aria-label="Footer">
        {navItems.map((item) => (
          <a href={item.href} class="footer-link">{item.label}</a>
        ))}
        <a href="https://www.itu.int/" rel="external" class="footer-link">ITU.int ↗</a>
        <a href="https://www.itu.int/itu-t/bulletin/" rel="external" class="footer-link">Official OB ↗</a>
      </nav>
      <a href="https://open.ribose.com/" class="footer-pill interactive powered-by">
        <span class="icon">
          <img class="logo" src="/assets/ribose-logo.png" alt="Ribose logo" />
        </span>
        Powered by Ribose
      </a>
    </footer>

    <CommandPalette client:idle />
  </body>
</html>
